# =============================================================================
# PwC AI Tutor — variables de entorno
# Copiá este archivo a ".env" y ajustá los valores según tu entorno.
# NUNCA commitear el archivo ".env" real (ver .gitignore). Contiene
# secretos locales en texto plano: no lo compartas ni lo subas a ningún
# repositorio ni chat. Ver docs/CONFIGURATION.md para el detalle completo
# de cada variable.
# =============================================================================

# -----------------------------------------------------------------------------
# Filesystem de cursos
# -----------------------------------------------------------------------------
# Ruta en el HOST (Windows) donde viven los cursos. Se monta como bind mount
# de solo lectura dentro del container backend en /content. Cada
# subdirectorio de primer nivel de esta carpeta es un curso.
# Por defecto usa la carpeta ./courses del propio repositorio (incluye el
# curso de demo). Podés apuntarla a otra ubicación, ej:
# COURSES_HOST_PATH=C:/Users/tu-usuario/Documents/cursos-pwc
# (usar barras "/" incluso en Windows evita problemas de escaping; ver
# docs/CONFIGURATION.md y scripts/setup.ps1, que normaliza esto por vos).
COURSES_HOST_PATH=./courses

# -----------------------------------------------------------------------------
# Backend / CORS
# -----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Proveedor LLM (texto) — ver docs/ARCHITECTURE.md
# -----------------------------------------------------------------------------
# Proveedor activo: "pwc" | "openai". Cualquier otro valor hace fallar el
# arranque de la funcionalidad de IA con un error de configuración claro
# (el resto de la app -- catálogo, cursos, tópicos -- sigue funcionando).
LLM_PROVIDER=pwc

PWC_GENAI_BASE_URL=https://genai-sharedservice-americas.pwcinternal.com
PWC_GENAI_API_KEY=
PWC_GENAI_MODEL=openai.gpt-4o-2024-11-20

# Fallback de compatibilidad: si PWC_GENAI_API_KEY no está definida, se usa
# esta variable en su lugar (algunos entornos ya la tienen configurada así).
GEN_AI_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Cache de LessonPlans (filesystem, sin base de datos)
# -----------------------------------------------------------------------------
# LESSON_CACHE_DIR/CERTIFICATION_CACHE_DIR/SPEECH_CACHE_DIR quedan fijos en
# docker-compose.yml (rutas DENTRO del container, alineadas con el bind
# mount ./data:/app/data) y no se leen desde este .env: cambiarlas acá no
# tiene efecto. Se muestran igual para que sepas dónde viven las caches en
# el filesystem del container.
LESSON_CACHE_DIR=/app/data/lesson-cache
# Versión del prompt de generación de clases; forma parte de la cache key.
# Cambiar esta versión invalida (por diseño) la cache existente.
LESSON_PROMPT_VERSION=lesson-v3.2.1

# -----------------------------------------------------------------------------
# Certificación — práctica/simulacro grounded (ver docs/ARCHITECTURE.md)
# -----------------------------------------------------------------------------
CERTIFICATION_PROMPT_VERSION=certification-v1
# Cantidad OBJETIVO de preguntas por tópico al generar un QuestionBank
# (no es un mínimo: un tópico corto puede devolver menos). Acotado 1-10.
CERTIFICATION_ITEMS_PER_TOPIC=6
# Cache de QuestionBanks (filesystem, sin base de datos).
CERTIFICATION_CACHE_DIR=/app/data/certification-cache
# Cantidad MÁXIMA de QuestionBanks generados EN PARALELO cuando faltan
# varios para completar una preparación (v1.1.0, ver docs/PERFORMANCE.md).
# Acotado en el backend a 1-4 sin importar este valor. 1 reproduce el
# comportamiento estrictamente secuencial de versiones anteriores.
CERTIFICATION_MAX_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Voz — Web Speech API (navegador, sin configuración) + TTS neural opcional
# -----------------------------------------------------------------------------
# Proveedor activo: "auto" | "browser" | "openai".
# - auto: usa voz neural (OpenAI TTS) si hay credencial configurada; si no,
#   usa la Web Speech API del navegador automáticamente.
# - browser: fuerza SIEMPRE la Web Speech API, aunque haya credencial de
#   OpenAI configurada (nunca llama a OpenAI TTS).
# - openai: intenta voz neural; si falla puntualmente, la app ofrece un
#   botón para usar la voz del navegador en su lugar (nunca rompe la clase).
VOICE_PROVIDER=auto

# Modelo/voz/instrucciones de OpenAI TTS. Solo se usan si VOICE_PROVIDER
# no es "browser" y OPENAI_API_KEY está configurada. NUNCA se envían desde
# el frontend: son configuración exclusiva del backend.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Si se deja vacío, el backend usa un default razonable ("Hablar en
# español claro, profesional y natural..." — ver app/config.py). Controla
# SOLO interpretación vocal, nunca reescribe el contenido pedagógico.
OPENAI_TTS_INSTRUCTIONS=

# Cache de audio sintetizado (filesystem, sin base de datos). Se puede
# borrar manualmente en cualquier momento sin romper nada.
SPEECH_CACHE_DIR=/app/data/speech-cache

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_VERSION=1.1.1

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
