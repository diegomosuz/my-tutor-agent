# Cache local de LessonPlans generadas por IA (Fase 3). Contenido
# regenerable, nunca se versiona; se conserva solo la carpeta vía .gitkeep.
data/lesson-cache/*
!data/lesson-cache/.gitkeep
data/certification-cache/*
!data/certification-cache/.gitkeep
